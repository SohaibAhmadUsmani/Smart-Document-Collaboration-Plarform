{
  "name": "smart-document-collaboration-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative document platform monorepo",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node --watch backend/src/server.js",
    "start:backend": "node backend/src/server.js",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "check:backend": "node --check backend/src/server.js",
    "check": "npm run check:backend"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-table-cell": "^3.30.3",
    "@tiptap/extension-table-header": "^3.30.3",
    "@tiptap/extension-table-row": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.34.0",
    "mongoose": "^9.9.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^7.1.3"
  }
}
